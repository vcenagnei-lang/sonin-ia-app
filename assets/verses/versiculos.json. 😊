[
  {"dia": 1, "ref": "Salmos 23:1", "texto": "O Senhor é o meu pastor; nada me faltará."},
  {"dia": 2, "ref": "Filipenses 4:13", "texto": "Tudo posso naquele que me fortalece."},
  {"dia": 3, "ref": "Jeremias 29:11", "texto": "Porque eu sei os planos que tenho para vocês, planos de fazê-los prosperar e não de causar dano, planos de dar a vocês esperança e um futuro."},
  {"dia": 4, "ref": "Isaías 41:10", "texto": "Não tema, pois estou com você; não se desanime, pois sou o seu Deus. Eu o fortalecerei e o ajudarei."},
  {"dia": 5, "ref": "Salmos 46:1", "texto": "Deus é o nosso refúgio e fortaleza, socorro bem presente nas tribulações."},
  {"dia": 6, "ref": "Provérbios 3:5-6", "texto": "Confie no Senhor de todo o seu coração e não se apoie em seu próprio entendimento. Reconheça o Senhor em todos os seus caminhos e Ele endireitará as suas veredas."},
  {"dia": 7, "ref": "Romanos 8:28", "texto": "Sabemos que todas as coisas cooperam para o bem daqueles que amam a Deus."},
  {"dia": 8, "ref": "Salmos 91:1", "texto": "Aquele que habita no abrigo do Altíssimo e descansa à sombra do Todo-Poderoso."},
  {"dia": 9, "ref": "Mateus 11:28", "texto": "Venham a mim, todos os que estão cansados e sobrecarregados, e eu lhes darei descanso."},
  {"dia": 10, "ref": "João 3:16", "texto": "Porque Deus amou o mundo de tal maneira que deu o seu Filho unigênito, para que todo o que nele crer não pereça, mas tenha a vida eterna."},
  {"dia": 11, "ref": "Salmos 121:1-2", "texto": "Elevo os olhos para os montes — donde me vem o socorro? O meu socorro vem do Senhor, que fez os céus e a terra."},
  {"dia": 12, "ref": "Isaías 40:31", "texto": "Mas os que esperam no Senhor renovarão as suas forças. Voarão alto como águias."},
  {"dia": 13, "ref": "Filipenses 4:7", "texto": "E a paz de Deus, que excede todo o entendimento, guardará os seus corações e as suas mentes em Cristo Jesus."},
  {"dia": 14, "ref": "1 João 4:19", "texto": "Nós amamos porque Ele nos amou primeiro."},
  {"dia": 15, "ref": "Salmos 37:4", "texto": "Deleite-se no Senhor, e Ele atenderá aos desejos do seu coração."},
  {"dia": 16, "ref": "Mateus 6:33", "texto": "Mas busquem em primeiro lugar o Reino de Deus e a sua justiça, e todas essas coisas lhes serão acrescentadas."},
  {"dia": 17, "ref": "Josué 1:9", "texto": "Seja forte e corajoso! Não se apavore nem desanime, pois o Senhor, o seu Deus, estará com você por onde você andar."},
  {"dia": 18, "ref": "Salmos 34:18", "texto": "O Senhor está perto dos que têm o coração quebrantado e salva os de espírito abatido."},
  {"dia": 19, "ref": "Efésios 2:8", "texto": "Pois vocês são salvos pela graça, por meio da fé, e isso não vem de vocês, é dom de Deus."},
  {"dia": 20, "ref": "Isaías 43:2", "texto": "Quando você atravessar as águas, eu estarei com você; quando atravessar os rios, eles não o submergirão."},
  {"dia": 21, "ref": "Salmos 16:8", "texto": "Tenho posto o Senhor sempre diante de mim; porque ele está à minha direita, não serei abalado."},
  {"dia": 22, "ref": "Romanos 15:13", "texto": "Que o Deus da esperança os encha de toda alegria e paz, por sua confiança nele, para que vocês transbordem de esperança pelo poder do Espírito Santo."},
  {"dia": 23, "ref": "Lamentações 3:22-23", "texto": "As misericórdias do Senhor não têm fim! Elas se renovam a cada manhã. Grande é a sua fidelidade!"},
  {"dia": 24, "ref": "Salmos 27:1", "texto": "O Senhor é a minha luz e a minha salvação; a quem temerei?"},
  {"dia": 25, "ref": "João 14:27", "texto": "Deixo com vocês a paz; a minha paz lhes dou. Não a dou como o mundo dá. Não se perturbe o coração de vocês, nem tenham medo."},
  {"dia": 26, "ref": "1 Pedro 5:7", "texto": "Lancem sobre Ele toda a sua ansiedade, pois Ele tem cuidado de vocês."},
  {"dia": 27, "ref": "Salmos 30:5", "texto": "O choro pode durar uma noite, mas a alegria vem pela manhã."},
  {"dia": 28, "ref": "Hebreus 11:1", "texto": "A fé é a certeza daquilo que esperamos e a prova das coisas que não vemos."},
  {"dia": 29, "ref": "Deuteronômio 31:6", "texto": "Seja forte e corajoso. Não tema nem se espante, porque o Senhor seu Deus vai com você; Ele nunca o deixará, nunca o abandonará."},
  {"dia": 30, "ref": "Salmos 118:24", "texto": "Este é o dia que o Senhor fez; alegremo-nos e nos regozijemos nele."},
  {"dia": 31, "ref": "Miquéias 7:7", "texto": "Quanto a mim, vigiarei o Senhor; esperarei no Deus da minha salvação; o meu Deus me ouvirá."},
  {"dia": 32, "ref": "João 10:10", "texto": "Eu vim para que tenham vida, e a tenham em abundância."},
  {"dia": 33, "ref": "Salmos 55:22", "texto": "Lança o teu cuidado sobre o Senhor, e ele te susterá; jamais permitirá que o justo seja abalado."},
  {"dia": 34, "ref": "Apocalipse 21:4", "texto": "Ele enxugará dos seus olhos toda lágrima. Não haverá mais morte, nem tristeza, nem choro, nem dor."},
  {"dia": 35, "ref": "Salmos 103:2", "texto": "Bendize, ó minha alma, ao Senhor, e não te esqueças de nenhum dos seus benefícios."},
  {"dia": 36, "ref": "Gálatas 5:22", "texto": "O fruto do Espírito é amor, alegria, paz, paciência, amabilidade, bondade, fidelidade."},
  {"dia": 37, "ref": "Isaías 26:3", "texto": "Tu guardarás em perfeita paz aquele cujo propósito está firme, porque em ti confia."},
  {"dia": 38, "ref": "Salmos 145:18", "texto": "O Senhor está perto de todos os que o invocam, de todos os que o invocam em verdade."},
  {"dia": 39, "ref": "2 Coríntios 5:17", "texto": "Se alguém está em Cristo, é nova criatura. As coisas antigas já passaram; eis que se tornaram novas!"},
  {"dia": 40, "ref": "Romanos 8:38-39", "texto": "Estou convencido de que nem a morte nem a vida, nem anjos nem demônios, nem o presente nem o futuro poderão nos separar do amor de Deus."},
  {"dia": 41, "ref": "Salmos 9:9", "texto": "O Senhor também será um alto refúgio para o oprimido, um alto refúgio nos tempos de angústia."},
  {"dia": 42, "ref": "Mateus 5:8", "texto": "Bem-aventurados os puros de coração, porque eles verão a Deus."},
  {"dia": 43, "ref": "Provérbios 31:25", "texto": "É revestida de força e de dignidade; ri-se do dia de amanhã."},
  {"dia": 44, "ref": "Salmos 62:5", "texto": "Descansa somente em Deus, ó minha alma, pois nele está a minha esperança."},
  {"dia": 45, "ref": "João 15:13", "texto": "Ninguém tem amor maior do que este: dar a própria vida pelos amigos."},
  {"dia": 46, "ref": "2 Timóteo 1:7", "texto": "Pois Deus não nos deu um espírito de covardia, mas de poder, de amor e de equilíbrio."},
  {"dia": 47, "ref": "Salmos 73:26", "texto": "A minha carne e o meu coração desfalecem; mas Deus é a força do meu coração e a minha porção para sempre."},
  {"dia": 48, "ref": "Jeremias 31:3", "texto": "Amei-te com amor eterno; por isso, com benignidade te atraí."},
  {"dia": 49, "ref": "Filipenses 4:19", "texto": "O meu Deus suprirá todas as suas necessidades, segundo as suas riquezas em glória em Cristo Jesus."},
  {"dia": 50, "ref": "Salmos 32:8", "texto": "Instruir-te-ei e te ensinarei o caminho que deves seguir; sobre ti fixarei os meus olhos."},
  {"dia": 51, "ref": "Mateus 7:7", "texto": "Peçam e lhes será dado; busquem e encontrarão; batam e a porta lhes será aberta."},
  {"dia": 52, "ref": "Salmos 19:14", "texto": "Sejam aceitáveis as palavras da minha boca e a meditação do meu coração diante de ti, ó Senhor."},
  {"dia": 53, "ref": "Hebreus 13:8", "texto": "Jesus Cristo é o mesmo ontem, hoje e para sempre."},
  {"dia": 54, "ref": "Salmos 84:11", "texto": "O Senhor Deus é sol e escudo; o Senhor concede graça e glória; não priva de bem algum os que andam em integridade."},
  {"dia": 55, "ref": "Efésios 3:20", "texto": "Ora, àquele que é poderoso para fazer infinitamente mais do que tudo quanto pedimos ou pensamos, de acordo com o seu poder que atua em nós."},
  {"dia": 56, "ref": "Salmos 40:3", "texto": "Pôs em meus lábios um cântico novo, um hino de louvor ao nosso Deus."},
  {"dia": 57, "ref": "Isaías 54:10", "texto": "Ainda que os montes se retirem e os outeiros sejam removidos, o meu amor não se retirará de ti."},
  {"dia": 58, "ref": "Salmos 107:1", "texto": "Rendei graças ao Senhor, porque ele é bom; porque a sua misericórdia dura para sempre."},
  {"dia": 59, "ref": "Mateus 6:34", "texto": "Portanto, não se preocupem com o dia de amanhã, pois o amanhã trará as suas próprias preocupações."},
  {"dia": 60, "ref": "1 Tessalonicenses 5:16-18", "texto": "Alegrai-vos sempre. Orai sem cessar. Em tudo dai graças."},
  {"dia": 61, "ref": "Salmos 150:6", "texto": "Tudo quanto tem fôlego louve ao Senhor! Aleluia!"},
  {"dia": 62, "ref": "Romanos 12:12", "texto": "Alegrem-se na esperança, sejam pacientes na tribulação, perseverem na oração."},
  {"dia": 63, "ref": "Salmos 138:3", "texto": "No dia em que clamei, tu me respondeste; e me fortaleceste com força na minha alma."},
  {"dia": 64, "ref": "João 8:32", "texto": "Conhecereis a verdade, e a verdade vos libertará."},
  {"dia": 65, "ref": "Salmos 5:3", "texto": "De manhã ouves a minha voz; de manhã te apresento a minha oração e fico esperando."},
  {"dia": 66, "ref": "Isaías 58:11", "texto": "O Senhor te guiará continuamente, saciará a tua alma nas securas e fortalecerá os teus ossos."},
  {"dia": 67, "ref": "Salmos 28:7", "texto": "O Senhor é a minha força e o meu escudo; nele o meu coração confia."},
  {"dia": 68, "ref": "2 Crônicas 7:14", "texto": "Se o meu povo, que se chama pelo meu nome, se humilhar, orar e buscar a minha face, eu ouvirei do céu e perdoarei os seus pecados."},
  {"dia": 69, "ref": "Salmos 4:8", "texto": "Em paz me deito e logo adormeço, porque só tu, Senhor, me fazes habitar em segurança."},
  {"dia": 70, "ref": "Apocalipse 3:20", "texto": "Eis que estou à porta e bato; se alguém ouvir a minha voz e abrir a porta, entrarei e cearei com ele."},
  {"dia": 71, "ref": "Salmos 143:8", "texto": "Faze-me ouvir pela manhã a tua misericórdia, porque em ti confio."},
  {"dia": 72, "ref": "Números 6:24-26", "texto": "O Senhor te abençoe e te guarde; o Senhor faça resplandecer o seu rosto sobre ti; o Senhor eleve sobre ti o seu rosto e te dê a paz."},
  {"dia": 73, "ref": "Salmos 139:14", "texto": "Graças te dou pelo modo assombroso e admirável como fui feito; maravilhosas são as tuas obras."},
  {"dia": 74, "ref": "Lucas 1:37", "texto": "Porque para Deus nada é impossível."},
  {"dia": 75, "ref": "Salmos 71:5", "texto": "Pois tu és a minha esperança, ó Senhor Deus; tu és a minha confiança desde a minha juventude."},
  {"dia": 76, "ref": "Tiago 1:17", "texto": "Toda a boa dádiva e todo o dom perfeito vêm do alto, descendo do Pai das luzes."},
  {"dia": 77, "ref": "Salmos 126:3", "texto": "O Senhor fez grandes coisas por nós, e por isso estamos alegres."},
  {"dia": 78, "ref": "João 16:33", "texto": "No mundo vocês terão aflições; contudo, tenham ânimo! Eu venci o mundo."},
  {"dia": 79, "ref": "Salmos 33:18", "texto": "Os olhos do Senhor estão sobre os que o temem, sobre os que esperam na sua misericórdia."},
  {"dia": 80, "ref": "Isaías 12:2", "texto": "Eis que Deus é a minha salvação; confiarei e não temerei."},
  {"dia": 81, "ref": "Salmos 25:4", "texto": "Senhor, faze-me conhecer os teus caminhos; ensina-me as tuas veredas."},
  {"dia": 82, "ref": "Efésios 6:10", "texto": "Finalmente, irmãos, fortalecei-vos no Senhor e na força do seu poder."},
  {"dia": 83, "ref": "Salmos 42:11", "texto": "Por que te abates, ó minha alma, e por que te perturbas em mim? Espera em Deus, pois ainda o louvarei."},
  {"dia": 84, "ref": "Filipenses 1:6", "texto": "Estou confiante de que aquele que começou boa obra em vocês a completará."},
  {"dia": 85, "ref": "Salmos 86:5", "texto": "Pois tu, Senhor, és bom, e pronto para perdoar, e abundante em misericórdia para com todos os que te invocam."},
  {"dia": 86, "ref": "Mateus 19:26", "texto": "Para os homens isso é impossível, mas para Deus tudo é possível."},
  {"dia": 87, "ref": "Salmos 100:4", "texto": "Entrai pelas suas portas com ação de graças e nos seus átrios, com louvor."},
  {"dia": 88, "ref": "Colossenses 3:15", "texto": "E que a paz de Cristo reine em seus corações, pois como membros de um só corpo vocês foram chamados à paz."},
  {"dia": 89, "ref": "Salmos 3:3", "texto": "Mas tu, Senhor, és o escudo que me rodeia, a minha glória e o que me ergue a cabeça."},
  {"dia": 90, "ref": "1 Coríntios 13:4", "texto": "O amor é paciente, o amor é bondoso. Não inveja, não se vangloria, não se orgulha."},
  {"dia": 91, "ref": "Salmos 119:105", "texto": "A tua palavra é lâmpada que ilumina os meus passos e luz que clareia o meu caminho."},
  {"dia": 92, "ref": "Romanos 5:1", "texto": "Tendo sido justificados pela fé, temos paz com Deus por meio de nosso Senhor Jesus Cristo."},
  {"dia": 93, "ref": "Salmos 72:18", "texto": "Bendito o Senhor Deus, o Deus de Israel, o único que faz maravilhas."},
  {"dia": 94, "ref": "Zacarias 4:6", "texto": "Não por força nem por violência, mas pelo meu Espírito, diz o Senhor dos Exércitos."},
  {"dia": 95, "ref": "Salmos 136:1", "texto": "Rendei graças ao Senhor porque ele é bom, porque a sua misericórdia dura para sempre."},
  {"dia": 96, "ref": "João 1:12", "texto": "Mas a todos quantos o receberam, aos que creem no seu nome, deu o poder de se tornarem filhos de Deus."},
  {"dia": 97, "ref": "Salmos 63:3", "texto": "Porque melhor é a tua misericórdia do que a vida; os meus lábios te louvarão."},
  {"dia": 98, "ref": "Isaías 55:8-9", "texto": "Os meus pensamentos não são os pensamentos de vocês, nem os seus caminhos são os meus caminhos, diz o Senhor."},
  {"dia": 99, "ref": "Salmos 20:4", "texto": "Que te conceda o desejo do teu coração e realize todos os teus planos."},
  {"dia": 100, "ref": "Marcos 11:24", "texto": "Por isso vos digo que tudo quanto em oração pedirdes, crede que o recebestes, e será assim convosco."},
  {"dia": 101, "ref": "Salmos 48:14", "texto": "Pois este Deus é o nosso Deus para sempre e eternamente; ele será o nosso guia até a morte."},
  {"dia": 102, "ref": "Romanos 8:1", "texto": "Portanto, não há agora nenhuma condenação para os que estão em Cristo Jesus."},
  {"dia": 103, "ref": "Salmos 57:10", "texto": "Porque a tua misericórdia é grande até aos céus, e a tua fidelidade até às nuvens."},
  {"dia": 104, "ref": "Provérbios 16:9", "texto": "O coração do homem planeja o seu caminho, mas é o Senhor quem lhe dirige os passos."},
  {"dia": 105, "ref": "Salmos 31:14", "texto": "Porém em ti confio, Senhor; digo: Tu és o meu Deus."},
  {"dia": 106, "ref": "Mateus 5:9", "texto": "Bem-aventurados os pacificadores, porque eles serão chamados filhos de Deus."},
  {"dia": 107, "ref": "Salmos 68:19", "texto": "Bendito seja o Senhor que dia a dia nos carrega, o Deus que é a nossa salvação."},
  {"dia": 108, "ref": "1 João 3:1", "texto": "Vede que grande amor o Pai nos concedeu! Somos chamados filhos de Deus. E de fato o somos!"},
  {"dia": 109, "ref": "Salmos 86:12", "texto": "Louvar-te-ei, Senhor, meu Deus, de todo o meu coração, e glorificarei o teu nome para sempre."},
  {"dia": 110, "ref": "Gálatas 6:9", "texto": "Não nos cansemos de fazer o bem, pois a seu tempo colheremos, se não desanimarmos."},
  {"dia": 111, "ref": "Salmos 116:1", "texto": "Amo o Senhor, pois ele ouviu a minha voz, as minhas súplicas."},
  {"dia": 112, "ref": "Colossenses 1:17", "texto": "Ele é antes de todas as coisas, e nele tudo subsiste."},
  {"dia": 113, "ref": "Salmos 93:1", "texto": "O Senhor reina! Está revestido de majestade; o Senhor está revestido de força."},
  {"dia": 114, "ref": "Efésios 1:3", "texto": "Bendito seja o Deus e Pai de nosso Senhor Jesus Cristo, que nos abençoou com todas as bênçãos espirituais nos lugares celestiais em Cristo."},
  {"dia": 115, "ref": "Salmos 145:9", "texto": "O Senhor é bom para com todos; a sua compaixão se estende a tudo o que criou."},
  {"dia": 116, "ref": "Jeremias 33:3", "texto": "Clama a mim, e eu te responderei, e te anunciarei coisas grandes e ocultas que não conheces."},
  {"dia": 117, "ref": "Salmos 34:8", "texto": "Provai e vede que o Senhor é bom; bem-aventurado o homem que nele se refugia."},
  {"dia": 118, "ref": "1 Coríntios 10:13", "texto": "Deus é fiel e não permitirá que vocês sejam tentados além do que podem suportar."},
  {"dia": 119, "ref": "Salmos 27:14", "texto": "Espera pelo Senhor; tem bom ânimo, e ele fortalecerá o teu coração."},
  {"dia": 120, "ref": "Isaías 43:19", "texto": "Estou prestes a fazer algo novo! Já está acontecendo; não percebem?"},
  {"dia": 121, "ref": "Salmos 46:10", "texto": "Aquietai-vos e sabei que eu sou Deus; serei exaltado entre as nações, serei exaltado na terra."},
  {"dia": 122, "ref": "Tito 3:5", "texto": "Ele nos salvou não por causa de obras de justiça que tínhamos praticado, mas por sua misericórdia."},
  {"dia": 123, "ref": "Salmos 50:15", "texto": "Invoca-me no dia da angústia; eu te livrarei, e tu me glorificarás."},
  {"dia": 124, "ref": "Lucas 18:27", "texto": "O que é impossível para os homens é possível para Deus."},
  {"dia": 125, "ref": "Salmos 71:14", "texto": "Quanto a mim, esperarei sempre e acrescentarei mais e mais ao teu louvor."},
  {"dia": 126, "ref": "João 14:6", "texto": "Eu sou o caminho, a verdade e a vida. Ninguém vem ao Pai senão por mim."},
  {"dia": 127, "ref": "Salmos 36:7", "texto": "Quão preciosa é a tua misericórdia, ó Deus! Por isso, os filhos dos homens se abrigam à sombra das tuas asas."},
  {"dia": 128, "ref": "Provérbios 18:10", "texto": "O nome do Senhor é uma torre forte; o justo corre para ela e está a salvo."},
  {"dia": 129, "ref": "Salmos 29:11", "texto": "O Senhor dará força ao seu povo; o Senhor abençoará o seu povo com a paz."},
  {"dia": 130, "ref": "Romanos 8:37", "texto": "Em todas estas coisas somos mais que vencedores por meio daquele que nos amou."},
  {"dia": 131, "ref": "Salmos 91:4", "texto": "Ele te cobrirá com as suas penas, e sob as suas asas te abrigarás."},
  {"dia": 132, "ref": "1 Crônicas 16:34", "texto": "Rendei graças ao Senhor, pois ele é bom; a sua misericórdia dura para sempre."},
  {"dia": 133, "ref": "Salmos 119:11", "texto": "No meu coração guardei as tuas palavras para não pecar contra ti."},
  {"dia": 134, "ref": "João 15:5", "texto": "Eu sou a videira; vocês são os ramos. Se alguém permanecer em mim e eu nele, esse dará muito fruto."},
  {"dia": 135, "ref": "Salmos 43:5", "texto": "Por que te abates, ó minha alma? Espera em Deus, pois ainda o louvarei, o meu Salvador e o meu Deus."},
  {"dia": 136, "ref": "Efésios 4:32", "texto": "Sejam bondosos e compassivos uns para com os outros, perdoando-se mutuamente, assim como Deus os perdoou em Cristo."},
  {"dia": 137, "ref": "Salmos 8:1", "texto": "Ó Senhor, Senhor nosso, quão magnífico é o teu nome em toda a terra!"},
  {"dia": 138, "ref": "Marcos 9:23", "texto": "Tudo é possível ao que crê."},
  {"dia": 139, "ref": "Salmos 145:13", "texto": "O teu reino é um reino eterno, e o teu domínio dura por todas as gerações."},
  {"dia": 140, "ref": "Filipenses 4:4", "texto": "Alegrem-se no Senhor sempre; novamente direi: alegrem-se!"},
  {"dia": 141, "ref": "Salmos 23:4", "texto": "Ainda que eu ande pelo vale da sombra da morte, não temerei mal nenhum, porque tu estás comigo."},
  {"dia": 142, "ref": "Hebreus 4:16", "texto": "Cheguemos confiantes ao trono da graça, a fim de recebermos misericórdia e de alcançarmos graça."},
  {"dia": 143, "ref": "Salmos 31:24", "texto": "Sede fortes, e o vosso coração se fortifique, todos vós que esperais no Senhor."},
  {"dia": 144, "ref": "Tiago 4:8", "texto": "Aproximem-se de Deus, e ele se aproximará de vocês."},
  {"dia": 145, "ref": "Salmos 147:3", "texto": "Ele sara os que têm o coração quebrantado e lhes curativos as feridas."},
  {"dia": 146, "ref": "Mateus 5:4", "texto": "Bem-aventurados os que choram, porque serão consolados."},
  {"dia": 147, "ref": "Salmos 90:17", "texto": "Que a graça do Senhor, nosso Deus, repouse sobre nós. Confirma em nós a obra das nossas mãos."},
  {"dia": 148, "ref": "2 Coríntios 4:17", "texto": "Pois os nossos sofrimentos leves e momentâneos estão produzindo para nós uma glória eterna que pesa muito mais do que todos eles."},
  {"dia": 149, "ref": "Salmos 59:16", "texto": "Quanto a mim, cantarei do teu poder e louvarei de manhã a tua misericórdia."},
  {"dia": 150, "ref": "João 15:16", "texto": "Não foram vocês que me escolheram, mas eu os escolhi e os designei para que vão e deem fruto."},
  {"dia": 151, "ref": "Salmos 18:2", "texto": "O Senhor é a minha rocha, a minha fortaleza e o meu libertador; o meu Deus, o meu rochedo em quem me refugio."},
  {"dia": 152, "ref": "1 Pedro 2:9", "texto": "Vocês são geração eleita, sacerdócio real, nação santa, povo de propriedade exclusiva de Deus."},
  {"dia": 153, "ref": "Salmos 37:23", "texto": "O Senhor firma os passos do homem de bem e se agrada do seu caminho."},
  {"dia": 154, "ref": "Romanos 10:9", "texto": "Se você confessar com a sua boca que Jesus é Senhor e crer em seu coração que Deus o ressuscitou dentre os mortos, será salvo."},
  {"dia": 155, "ref": "Salmos 64:10", "texto": "Os justos regozijar-se-ão no Senhor e nele se refugiarão; todos os que têm o coração reto o louvarão."},
  {"dia": 156, "ref": "Isaías 40:28", "texto": "O Senhor é o Deus eterno, o Criador de toda a terra. Ele nunca se cansa nem se esgota."},
  {"dia": 157, "ref": "Salmos 112:7", "texto": "Não tem medo de más notícias; o seu coração está firme, confiante no Senhor."},
  {"dia": 158, "ref": "Mateus 18:20", "texto": "Pois onde dois ou três se reúnem em meu nome, aí estou eu no meio deles."},
  {"dia": 159, "ref": "Salmos 34:4", "texto": "Busquei o Senhor, e ele me respondeu; livrou-me de todos os meus temores."},
  {"dia": 160, "ref": "Efésios 2:10", "texto": "Pois somos criação de Deus, criados em Cristo Jesus para fazer boas obras."},
  {"dia": 161, "ref": "Salmos 66:20", "texto": "Bendito seja Deus, que não rejeitou a minha oração nem me negou o seu amor!"},
  {"dia": 162, "ref": "Colossenses 3:2", "texto": "Afixem o pensamento nas coisas do alto, não nas coisas da terra."},
  {"dia": 163, "ref": "Salmos 103:13", "texto": "Como um pai tem compaixão dos filhos, o Senhor tem compaixão dos que o temem."},
  {"dia": 164, "ref": "2 Pedro 3:9", "texto": "O Senhor não demora em cumprir a sua promessa. Ele é paciente para com vocês."},
  {"dia": 165, "ref": "Salmos 37:7", "texto": "Fica quieto diante do Senhor e aguarda por ele com paciência."},
  {"dia": 166, "ref": "João 11:25", "texto": "Eu sou a ressurreição e a vida. Aquele que crê em mim, ainda que morra, viverá."},
  {"dia": 167, "ref": "Salmos 145:3", "texto": "Grande é o Senhor e digno de todo o louvor; a sua grandeza é insondável."},
  {"dia": 168, "ref": "Isaías 40:29", "texto": "Ele fortalece o cansado e aumenta o vigor do fraco."},
  {"dia": 169, "ref": "Salmos 22:24", "texto": "Pois não desprezou nem rejeitou o sofrimento do aflito; nem ocultou dele o seu rosto, mas ouviu o seu grito de socorro."},
  {"dia": 170, "ref": "Romanos 12:2", "texto": "Não se amoldem ao padrão deste mundo, mas transformem-se pela renovação da sua mente."},
  {"dia": 171, "ref": "Salmos 34:15", "texto": "Os olhos do Senhor estão sobre os justos, e os seus ouvidos atentos ao seu clamor."},
  {"dia": 172, "ref": "Hebreus 12:1", "texto": "Corramos com perseverança a corrida que nos é proposta."},
  {"dia": 173, "ref": "Salmos 56:3", "texto": "Quando eu tiver medo, confiarei em ti."},
  {"dia": 174, "ref": "1 João 5:14", "texto": "Esta é a confiança que temos ao nos aproximarmos de Deus: se pedirmos alguma coisa de acordo com a sua vontade, ele nos ouve."},
  {"dia": 175, "ref": "Salmos 25:5", "texto": "Guia-me na tua verdade e ensina-me, porque tu és o Deus da minha salvação."},
  {"dia": 176, "ref": "2 Coríntios 12:9", "texto": "O meu poder se aperfeiçoa na fraqueza. Portanto, de boa vontade me gloriarei nas minhas fraquezas."},
  {"dia": 177, "ref": "Salmos 91:11", "texto": "Pois dará ordens aos seus anjos a seu respeito, para guardá-lo em todos os seus caminhos."},
  {"dia": 178, "ref": "Mateus 6:26", "texto": "Olhem para os pássaros do céu: não semeiam, nem colhem, nem guardam em celeiros; contudo, o Pai celestial os alimenta."},
  {"dia": 179, "ref": "Salmos 33:4", "texto": "Porque a palavra do Senhor é reta, e toda a sua obra é feita com fidelidade."},
  {"dia": 180, "ref": "Filipenses 4:11", "texto": "Aprendi a contentar-me em qualquer estado em que me encontre."},
  {"dia": 181, "ref": "Salmos 71:23", "texto": "Os meus lábios se alegrarão quando eu te louvar, e também a minha alma, que tu resgataste."},
  {"dia": 182, "ref": "Isaías 43:1", "texto": "Não temas, pois eu te remi; chamei-te pelo teu nome; tu és meu."},
  {"dia": 183, "ref": "Salmos 116:5", "texto": "Gracioso e justo é o Senhor; sim, compassivo é o nosso Deus."},
  {"dia": 184, "ref": "Romanos 15:4", "texto": "Tudo que foi escrito no passado foi escrito para nos ensinar, a fim de que mediante a perseverança e o encorajamento das Escrituras tenhamos esperança."},
  {"dia": 185, "ref": "Salmos 25:9", "texto": "Ele guia os humildes na justiça e ensina o seu caminho aos mansos."},
  {"dia": 186, "ref": "João 14:1", "texto": "Não se perturbe o coração de vocês. Creiam em Deus; creiam também em mim."},
  {"dia": 187, "ref": "Salmos 34:1", "texto": "Bendirei o Senhor em todo o tempo; o seu louvor estará sempre nos meus lábios."},
  {"dia": 188, "ref": "Deuteronômio 7:9", "texto": "Saiba, portanto, que o Senhor seu Deus é Deus; ele é o Deus fiel que mantém a sua aliança de amor."},
  {"dia": 189, "ref": "Salmos 18:30", "texto": "Quanto a Deus, o seu caminho é perfeito; a palavra do Senhor é provada; ele é escudo de todos os que nele confiam."},
  {"dia": 190, "ref": "Mateus 5:6", "texto": "Bem-aventurados os que têm fome e sede de justiça, porque serão saciados."},
  {"dia": 191, "ref": "Salmos 103:1", "texto": "Bendize, ó minha alma, ao Senhor, e tudo o que há em mim bendiga o seu santo nome."},
  {"dia": 192, "ref": "1 Pedro 1:3", "texto": "Bendito seja o Deus e Pai de nosso Senhor Jesus Cristo! Segundo a sua grande misericórdia, ele nos fez nascer de novo."},
  {"dia": 193, "ref": "Salmos 17:8", "texto": "Guarda-me como a menina dos olhos; esconde-me à sombra das tuas asas."},
  {"dia": 194, "ref": "Hebreus 11:6", "texto": "Sem fé é impossível agradar a Deus, pois quem dele se aproxima precisa crer que ele existe."},
  {"dia": 195, "ref": "Salmos 47:1", "texto": "Batei palmas, todos os povos; aclamai a Deus com voz de júbilo."},
  {"dia": 196, "ref": "Lucas 6:38", "texto": "Deem, e lhes será dado; uma boa medida, calcada, sacudida e transbordante será deitada no seu colo."},
  {"dia": 197, "ref": "Salmos 37:25", "texto": "Fui moço, e agora sou velho; porém jamais vi o justo desamparado."},
  {"dia": 198, "ref": "Apocalipse 22:13", "texto": "Eu sou o Alfa e o Ômega, o Primeiro e o Último, o Princípio e o Fim."},
  {"dia": 199, "ref": "Salmos 84:4", "texto": "Felizes os que habitam na tua casa! Eles te louvam continuamente."},
  {"dia": 200, "ref": "Jeremias 17:7", "texto": "Bendito é o homem que confia no Senhor, cuja confiança está no Senhor."},
  {"dia": 201, "ref": "Salmos 96:2", "texto": "Cantai ao Senhor, bendizei o seu nome; anunciai de dia em dia a sua salvação."},
  {"dia": 202, "ref": "Romanos 5:5", "texto": "E a esperança não nos decepciona, porque Deus derramou o seu amor em nossos corações."},
  {"dia": 203, "ref": "Salmos 128:1", "texto": "Bem-aventurado aquele que teme ao Senhor e anda nos seus caminhos."},
  {"dia": 204, "ref": "2 Coríntios 9:8", "texto": "Deus pode fazer com que toda a graça seja dada a vocês em abundância, a fim de que em todas as coisas e em todo o tempo vocês tenham tudo o que precisam."},
  {"dia": 205, "ref": "Salmos 118:1", "texto": "Rendei graças ao Senhor, porque ele é bom, e a sua misericórdia dura para sempre."},
  {"dia": 206, "ref": "Colossenses 3:17", "texto": "E tudo o que fizerem, seja em palavras ou atos, façam-no em nome do Senhor Jesus, dando graças a Deus Pai por meio dele."},
  {"dia": 207, "ref": "Salmos 145:14", "texto": "O Senhor sustenta todos os que caem e levanta todos os que estão curvados."},
  {"dia": 208, "ref": "João 15:7", "texto": "Se vocês permanecerem em mim e as minhas palavras permanecerem em vocês, peçam o que quiserem e lhes será feito."},
  {"dia": 209, "ref": "Salmos 57:7", "texto": "O meu coração está firme, ó Deus, o meu coração está firme; cantarei e entoarei louvores."},
  {"dia": 210, "ref": "Efésios 3:17", "texto": "Para que Cristo habite nos seus corações pela fé, e que vocês, enraizados e alicerçados no amor."},
  {"dia": 211, "ref": "Salmos 42:8", "texto": "De dia o Senhor me envia o seu amor; à noite o seu canto está comigo, uma oração ao Deus da minha vida."},
  {"dia": 212, "ref": "Provérbios 3:24", "texto": "Quando você se deitar, não terá medo; sim, você se deitará e o seu sono será tranquilo."},
  {"dia": 213, "ref": "Salmos 23:6", "texto": "Certamente a bondade e a misericórdia me seguirão todos os dias da minha vida."},
  {"dia": 214, "ref": "1 Coríntios 15:57", "texto": "Mas graças a Deus que nos dá a vitória por meio de nosso Senhor Jesus Cristo!"},
  {"dia": 215, "ref": "Salmos 71:8", "texto": "A minha boca estará cheia do teu louvor e da tua glória o dia inteiro."},
  {"dia": 216, "ref": "Isaías 30:21", "texto": "Quer você se desvie para a direita, quer para a esquerda, os seus ouvidos ouvirão uma voz atrás de você, dizendo: Este é o caminho; andem nele."},
  {"dia": 217, "ref": "Salmos 55:17", "texto": "De tarde, de manhã e ao meio-dia orarei e clamarei, e ele ouvirá a minha voz."},
  {"dia": 218, "ref": "Hebreus 13:5", "texto": "Deus disse: Nunca o deixarei, nunca o abandonarei."},
  {"dia": 219, "ref": "Salmos 31:7", "texto": "Alegrar-me-ei e me regozijarei na tua misericórdia, pois viste a minha aflição."},
  {"dia": 220, "ref": "Marcos 12:30", "texto": "Ame o Senhor seu Deus de todo o seu coração, com toda a sua alma, com todo o seu entendimento e com todas as suas forças."},
  {"dia": 221, "ref": "Salmos 111:10", "texto": "O temor do Senhor é o princípio da sabedoria."},
  {"dia": 222, "ref": "Filipenses 2:13", "texto": "Pois é Deus quem opera em vocês o querer e o realizar, de acordo com o seu bom propósito."},
  {"dia": 223, "ref": "Salmos 91:15", "texto": "Ele me invocará, e eu lhe responderei; estarei com ele na angústia."},
  {"dia": 224, "ref": "João 17:3", "texto": "Esta é a vida eterna: que te conheçam a ti, o único Deus verdadeiro, e a Jesus Cristo, a quem enviaste."},
  {"dia": 225, "ref": "Salmos 34:7", "texto": "O anjo do Senhor acampa ao redor dos que o temem e os livra."},
  {"dia": 226, "ref": "1 Coríntios 2:9", "texto": "Olho nenhum viu, ouvido nenhum ouviu, mente nenhuma imaginou o que Deus preparou para aqueles que o amam."},
  {"dia": 227, "ref": "Salmos 103:17", "texto": "Mas a misericórdia do Senhor vai de eternidade à eternidade sobre os que o temem."},
  {"dia": 228, "ref": "Romanos 8:14", "texto": "Porque todos os que são guiados pelo Espírito de Deus são filhos de Deus."},
  {"dia": 229, "ref": "Salmos 119:114", "texto": "Tu és o meu esconderijo e o meu escudo; esperei na tua palavra."},
  {"dia": 230, "ref": "Isaías 41:13", "texto": "Pois eu sou o Senhor, o seu Deus, que o seguro pela mão direita e lhe digo: Não tema; eu o ajudarei."},
  {"dia": 231, "ref": "Salmos 40:1", "texto": "Esperando, esperei no Senhor; e ele se inclinou para mim e ouviu o meu clamor."},
  {"dia": 232, "ref": "Mateus 6:6", "texto": "Mas você, quando orar, entre no seu quarto, feche a porta e ore ao seu Pai, que está no secreto."},
  {"dia": 233, "ref": "Salmos 130:5", "texto": "Espero pelo Senhor, a minha alma espera, e na sua palavra ponho a minha esperança."},
  {"dia": 234, "ref": "1 Timóteo 6:6", "texto": "É claro que há grande lucro na piedade com contentamento."},
  {"dia": 235, "ref": "Salmos 145:8", "texto": "Gracioso e compassivo é o Senhor, tardio em irar-se e transbordante de amor."},
  {"dia": 236, "ref": "2 Coríntios 1:3", "texto": "Bendito seja o Deus e Pai de nosso Senhor Jesus Cristo, o Pai das misericórdias e o Deus de toda a consolação."},
  {"dia": 237, "ref": "Salmos 16:11", "texto": "Tu me mostrarás a vereda da vida; na tua presença há plenitude de alegria; na tua destra, delícias perpetuamente."},
  {"dia": 238, "ref": "Efésios 6:18", "texto": "Orando em todo o tempo com toda a oração e súplica no Espírito."},
  {"dia": 239, "ref": "Salmos 86:15", "texto": "Mas tu, Senhor, és Deus compassivo e clemente, tardio em irar-te e transbordante de amor e fidelidade."},
  {"dia": 240, "ref": "Miquéias 6:8", "texto": "Agir com justiça, amar a misericórdia e andar humildemente com o seu Deus."},
  {"dia": 241, "ref": "Salmos 119:105", "texto": "A tua palavra é lâmpada para os meus pés e luz para o meu caminho."},
  {"dia": 242, "ref": "João 4:24", "texto": "Deus é Espírito, e é necessário que os seus adoradores o adorem em espírito e em verdade."},
  {"dia": 243, "ref": "Salmos 92:4", "texto": "Pois tu, Senhor, me alegraste com as tuas obras; por isso, cantarei de júbilo pelas obras das tuas mãos."},
  {"dia": 244, "ref": "Gálatas 2:20", "texto": "Já fui crucificado com Cristo. Quem vive não sou mais eu, mas Cristo vive em mim."},
  {"dia": 245, "ref": "Salmos 34:6", "texto": "Este pobre clamou, e o Senhor o ouviu e o salvou de todas as suas angústias."},
  {"dia": 246, "ref": "Provérbios 19:21", "texto": "O coração do homem pode ter muitos planos, mas o que prevalece é o propósito do Senhor."},
  {"dia": 247, "ref": "Salmos 130:7", "texto": "Ó Israel, espera no Senhor, porque no Senhor há amor leal, e nele há plena redenção."},
  {"dia": 248, "ref": "2 Tessalonicenses 3:3", "texto": "O Senhor é fiel; ele os fortalecerá e os protegerá do maligno."},
  {"dia": 249, "ref": "Salmos 63:1", "texto": "Ó Deus, tu és o meu Deus; de madrugada te buscarei; a minha alma tem sede de ti."},
  {"dia": 250, "ref": "Hebreus 10:23", "texto": "Mantenham firme a esperança que professamos, pois fiel é aquele que prometeu."},
  {"dia": 251, "ref": "Salmos 67:1", "texto": "Deus se compadeça de nós e nos abençoe; faça resplandecer o seu rosto sobre nós."},
  {"dia": 252, "ref": "João 6:35", "texto": "Eu sou o pão da vida. Aquele que vem a mim nunca terá fome; o que crê em mim jamais terá sede."},
  {"dia": 253, "ref": "Salmos 119:76", "texto": "Que a tua misericórdia me console, conforme a tua promessa ao teu servo."},
  {"dia": 254, "ref": "Efésios 5:20", "texto": "Dando sempre graças a Deus Pai por tudo, em nome de nosso Senhor Jesus Cristo."},
  {"dia": 255, "ref": "Salmos 18:46", "texto": "Vive o Senhor! Bendito seja o meu rochedo! Exaltado seja o Deus da minha salvação!"},
  {"dia": 256, "ref": "Isaías 55:11", "texto": "Assim é a minha palavra que sai da minha boca: ela não voltará para mim vazia, mas realizará o que desejo."},
  {"dia": 257, "ref": "Salmos 139:23-24", "texto": "Sonda-me, ó Deus, e conhece o meu coração; prova-me e conhece os meus pensamentos."},
  {"dia": 258, "ref": "1 João 1:9", "texto": "Se confessarmos os nossos pecados, ele é fiel e justo para perdoar os nossos pecados e nos purificar de toda injustiça."},
  {"dia": 259, "ref": "Salmos 31:3", "texto": "Pois tu és a minha rocha e a minha fortaleza; por amor do teu nome, guia-me e dirige-me."},
  {"dia": 260, "ref": "Marcos 10:27", "texto": "Para os homens é impossível, mas não para Deus; para Deus tudo é possível."},
  {"dia": 261, "ref": "Salmos 28:6", "texto": "Bendito seja o Senhor, pois ele ouviu a minha súplica."},
  {"dia": 262, "ref": "Provérbios 22:6", "texto": "Instrua a criança no caminho em que deve andar e, mesmo quando for velha, não se desviará dele."},
  {"dia": 263, "ref": "Salmos 119:130", "texto": "A exposição das tuas palavras ilumina; dá entendimento aos simples."},
  {"dia": 264, "ref": "Tiago 5:16", "texto": "A oração fervorosa do justo é muito poderosa e eficaz."},
  {"dia": 265, "ref": "Salmos 86:7", "texto": "No dia da minha angústia clamarei a ti, pois tu me responderás."},
  {"dia": 266, "ref": "João 10:27-28", "texto": "As minhas ovelhas ouvem a minha voz; eu as conheço, e elas me seguem. Eu lhes dou a vida eterna."},
  {"dia": 267, "ref": "Salmos 100:3", "texto": "Reconhecei que o Senhor é Deus; foi ele quem nos fez, e a ele pertencemos."},
  {"dia": 268, "ref": "1 Coríntios 13:13", "texto": "Agora, pois, permanecem a fé, a esperança e o amor, esses três; porém o maior deles é o amor."},
  {"dia": 269, "ref": "Salmos 40:8", "texto": "Deleito-me em fazer a tua vontade, ó meu Deus; a tua lei está no íntimo do meu ser."},
  {"dia": 270, "ref": "Mateus 5:7", "texto": "Bem-aventurados os misericordiosos, porque alcançarão misericórdia."},
  {"dia": 271, "ref": "Salmos 94:18", "texto": "Quando eu disse: O meu pé está escorregando; a tua misericórdia, Senhor, me sustentou."},
  {"dia": 272, "ref": "Romanos 12:1", "texto": "Portanto, irmãos, rogo-lhes pelas misericórdias de Deus que se ofereçam em sacrifício vivo, santo e agradável a Deus."},
  {"dia": 273, "ref": "Salmos 9:1", "texto": "Louvar-te-ei, Senhor, de todo o meu coração; contarei todas as tuas maravilhas."},
  {"dia": 274, "ref": "Marcos 11:22", "texto": "Tenham fé em Deus."},
  {"dia": 275, "ref": "Salmos 31:19", "texto": "Quão grande é a tua bondade que reservaste para os que te temem!"},
  {"dia": 276, "ref": "Filipenses 3:14", "texto": "Prossigo para o alvo, para o prêmio do chamado celestial de Deus em Cristo Jesus."},
  {"dia": 277, "ref": "Salmos 145:16", "texto": "Abres a tua mão e satisfazes o desejo de todo ser vivente."},
  {"dia": 278, "ref": "João 14:13", "texto": "E tudo o que vocês pedirem em meu nome eu farei, para que o Pai seja glorificado no Filho."},
  {"dia": 279, "ref": "Salmos 18:28", "texto": "Pois tu, ó Senhor, accenderás a minha lâmpada; o Senhor, meu Deus, iluminará as minhas trevas."},
  {"dia": 280, "ref": "2 Coríntios 3:17", "texto": "Ora, o Senhor é o Espírito, e onde está o Espírito do Senhor, aí há liberdade."},
  {"dia": 281, "ref": "Salmos 62:8", "texto": "Confiai nele em todo o tempo, ó povo; derramai o vosso coração diante dele; Deus é o nosso refúgio."},
  {"dia": 282, "ref": "Provérbios 4:23", "texto": "Acima de tudo, guarde o seu coração, pois dele dependem as questões da vida."},
  {"dia": 283, "ref": "Salmos 18:32", "texto": "É Deus que me reveste de força e que torna perfeito o meu caminho."},
  {"dia": 284, "ref": "1 Pedro 3:12", "texto": "Pois os olhos do Senhor estão sobre os justos, e os seus ouvidos estão atentos à oração deles."},
  {"dia": 285, "ref": "Salmos 105:1", "texto": "Louvai ao Senhor e invocai o seu nome; anunciai os seus feitos entre os povos."},
  {"dia": 286, "ref": "Romanos 8:26", "texto": "O Espírito também vem em auxílio da nossa fraqueza, pois não sabemos orar como convém, mas o próprio Espírito intercede por nós."},
  {"dia": 287, "ref": "Salmos 119:58", "texto": "Com todo o coração procurei o teu favor; tem misericórdia de mim, conforme a tua promessa."},
  {"dia": 288, "ref": "Lucas 11:9", "texto": "Peçam e lhes será dado; busquem e encontrarão; batam e a porta lhes será aberta."},
  {"dia": 289, "ref": "Salmos 36:9", "texto": "Pois em ti está a fonte da vida; na tua luz vemos a luz."},
  {"dia": 290, "ref": "Efésios 4:2", "texto": "Sejam completamente humildes e gentis; sejam pacientes, suportando uns aos outros com amor."},
  {"dia": 291, "ref": "Salmos 27:4", "texto": "Uma coisa pedi ao Senhor, e a buscarei: que eu possa habitar na casa do Senhor todos os dias da minha vida."},
  {"dia": 292, "ref": "João 3:30", "texto": "É preciso que ele cresça e que eu diminua."},
  {"dia": 293, "ref": "Salmos 40:5", "texto": "Muitas são, Senhor, meu Deus, as maravilhas que fizeste e os teus pensamentos para conosco."},
  {"dia": 294, "ref": "Hebreus 6:10", "texto": "Deus não é injusto; não esquecerá o trabalho de vocês e o amor que demonstraram ao servi-lo."},
  {"dia": 295, "ref": "Salmos 52:8", "texto": "Mas eu sou como uma oliveira verde na casa de Deus; confio na graça de Deus para sempre e eternamente."},
  {"dia": 296, "ref": "Mateus 5:16", "texto": "Assim brilhe a luz de vocês diante dos homens, para que vejam as suas boas obras e glorifiquem o Pai de vocês."},
  {"dia": 297, "ref": "Salmos 119:143", "texto": "A angústia e a aflição me acometeram, mas os teus mandamentos são o meu prazer."},
  {"dia": 298, "ref": "1 Tessal. 4:17", "texto": "E assim estaremos com o Senhor para sempre."},
  {"dia": 299, "ref": "Salmos 27:13", "texto": "Estou certo de que verei a bondade do Senhor na terra dos viventes."},
  {"dia": 300, "ref": "Isaías 46:4", "texto": "Mesmo na velhice, quando os cabelos embranquecerem, eu os sustentarei. Fiz isso e continuarei a fazê-lo."},
  {"dia": 301, "ref": "Salmos 145:21", "texto": "Que minha boca proclame o louvor do Senhor. Que toda criatura louve o seu santo nome."},
  {"dia": 302, "ref": "1 João 4:4", "texto": "Vocês são de Deus, filhinhos, e os venceram, porque maior é aquele que está em vocês do que o que está no mundo."},
  {"dia": 303, "ref": "Salmos 33:22", "texto": "Que a tua misericórdia, Senhor, esteja sobre nós, assim como em ti esperamos."},
  {"dia": 304, "ref": "Hebreus 4:12", "texto": "Pois a palavra de Deus é viva e eficaz, e mais afiada do que qualquer espada de dois gumes."},
  {"dia": 305, "ref": "Salmos 119:165", "texto": "Abundante paz têm os que amam a tua lei, e nada os fará tropeçar."},
  {"dia": 306, "ref": "João 8:12", "texto": "Eu sou a luz do mundo. Quem me segue não andará nas trevas, mas terá a luz da vida."},
  {"dia": 307, "ref": "Salmos 18:1", "texto": "Eu te amo, Senhor, força minha."},
  {"dia": 308, "ref": "Colossenses 4:2", "texto": "Dediquem-se à oração, sendo vigilantes e agradecidos."},
  {"dia": 309, "ref": "Salmos 31:5", "texto": "Nas tuas mãos entrego o meu espírito; tu me remiste, Senhor, Deus fiel."},
  {"dia": 310, "ref": "Romanos 8:31", "texto": "Se Deus é por nós, quem será contra nós?"},
  {"dia": 311, "ref": "Salmos 25:1", "texto": "A ti, Senhor, elevo a minha alma."},
  {"dia": 312, "ref": "João 15:11", "texto": "Disse-lhes isso para que a minha alegria esteja em vocês e a alegria de vocês seja completa."},
  {"dia": 313, "ref": "Salmos 103:5", "texto": "Ele sacia de bens a sua velhice, para que a sua juventude se renove como a da águia."},
  {"dia": 314, "ref": "Josué 24:15", "texto": "Quanto a mim e à minha família, serviremos ao Senhor."},
  {"dia": 315, "ref": "Salmos 86:11", "texto": "Ensina-me, Senhor, o teu caminho, e eu andarei na tua verdade."},
  {"dia": 316, "ref": "2 Coríntios 4:16", "texto": "Por isso não desanimamos. Embora exteriormente estejamos nos desgastando, interiormente estamos sendo renovados dia após dia."},
  {"dia": 317, "ref": "Salmos 34:14", "texto": "Aparta-te do mal e faze o bem; procura a paz e segue-a."},
  {"dia": 318, "ref": "Mateus 22:37", "texto": "Ame o Senhor seu Deus de todo o seu coração, com toda a sua alma e com todo o seu entendimento."},
  {"dia": 319, "ref": "Salmos 119:2", "texto": "Felizes os que guardam os seus testemunhos e o buscam de todo o coração."},
  {"dia": 320, "ref": "Efésios 1:7", "texto": "Nele temos a redenção por meio do seu sangue, o perdão dos pecados, conforme as riquezas da graça de Deus."},
  {"dia": 321, "ref": "Salmos 96:9", "texto": "Adorai o Senhor na beleza da santidade; temei diante dele toda a terra."},
  {"dia": 322, "ref": "1 Pedro 5:6", "texto": "Portanto, humilhem-se sob a poderosa mão de Deus, para que ele os exalte no momento certo."},
  {"dia": 323, "ref": "Salmos 119:50", "texto": "Isto me consola na minha aflição: a tua promessa que me dá vida."},
  {"dia": 324, "ref": "João 20:29", "texto": "Felizes os que não viram e creram."},
  {"dia": 325, "ref": "Salmos 97:11", "texto": "A luz está semeada para o justo, e a alegria, para os retos de coração."},
  {"dia": 326, "ref": "Romanos 8:15", "texto": "Pois não receberam um espírito que os faça escravos novamente ao medo, mas o Espírito que os adota como filhos."},
  {"dia": 327, "ref": "Salmos 37:4", "texto": "Deleite-se no Senhor, e Ele atenderá aos desejos do seu coração."},
  {"dia": 328, "ref": "Hebreus 11:1", "texto": "A fé é a certeza daquilo que esperamos e a prova das coisas que não vemos."},
  {"dia": 329, "ref": "Salmos 46:7", "texto": "O Senhor dos Exércitos está conosco; o Deus de Jacó é o nosso refúgio."},
  {"dia": 330, "ref": "Isaías 43:5", "texto": "Não temas, pois estou com você; do oriente trarei a tua descendência."},
  {"dia": 331, "ref": "Salmos 116:12", "texto": "Como retribuirei ao Senhor todos os seus benefícios para comigo?"},
  {"dia": 332, "ref": "Filipenses 4:6", "texto": "Não se preocupem com coisa alguma; antes, em tudo, pela oração e súplicas com ações de graças."},
  {"dia": 333, "ref": "Salmos 27:8", "texto": "O meu coração disse da tua parte: Buscai o meu rosto. O teu rosto, Senhor, buscarei."},
  {"dia": 334, "ref": "Lucas 19:10", "texto": "O Filho do homem veio procurar e salvar o que se tinha perdido."},
  {"dia": 335, "ref": "Salmos 139:17", "texto": "Quão preciosos me são, ó Deus, os teus pensamentos! Quão grande é a soma deles!"},
  {"dia": 336, "ref": "2 Coríntios 13:11", "texto": "Vivam em paz, e o Deus do amor e da paz estará com vocês."},
  {"dia": 337, "ref": "Salmos 107:9", "texto": "Pois satisfaz a alma sequiosa e enche de bens a alma faminta."},
  {"dia": 338, "ref": "Mateus 6:9-10", "texto": "Pai nosso, que estás nos céus! Santificado seja o teu nome. Venha o teu reino."},
  {"dia": 339, "ref": "Salmos 68:35", "texto": "Deus é temível no seu santuário; o Deus de Israel dá força e vigor ao povo."},
  {"dia": 340, "ref": "João 14:2", "texto": "Na casa de meu Pai há muitas moradas. Se não fosse assim, eu teria dito a vocês."},
  {"dia": 341, "ref": "Salmos 145:2", "texto": "Todos os dias te abençoarei e louvarei o teu nome para sempre e eternamente."},
  {"dia": 342, "ref": "Isaías 60:1", "texto": "Levanta-te e resplandece, pois chegou a tua luz, e a glória do Senhor se ergue sobre ti!"},
  {"dia": 343, "ref": "Salmos 85:7", "texto": "Mostra-nos, Senhor, a tua misericórdia e nos dá a tua salvação."},
  {"dia": 344, "ref": "1 Coríntios 16:13", "texto": "Estejam alertas; permaneçam firmes na fé; sejam corajosos e fortes."},
  {"dia": 345, "ref": "Salmos 119:175", "texto": "Que a minha alma viva para te louvar, e que os teus juízos me ajudem."},
  {"dia": 346, "ref": "Provérbios 3:9", "texto": "Honra ao Senhor com os teus bens e com as primícias de toda a tua renda."},
  {"dia": 347, "ref": "Salmos 34:9", "texto": "Temei ao Senhor, seus santos, pois os que o temem nada têm de que carecer."},
  {"dia": 348, "ref": "Romanos 15:33", "texto": "Que o Deus da paz esteja com todos vocês. Amém."},
  {"dia": 349, "ref": "Salmos 113:3", "texto": "Do nascente ao poente, seja louvado o nome do Senhor."},
  {"dia": 350, "ref": "João 3:36", "texto": "Quem crê no Filho tem a vida eterna."},
  {"dia": 351, "ref": "Salmos 65:2", "texto": "A ti, que ouves a oração, todos os homens virão."},
  {"dia": 352, "ref": "Filipenses 4:8", "texto": "Tudo o que for verdadeiro, honesto, justo, puro, amável e de boa fama, nisso pensem."},
  {"dia": 353, "ref": "Salmos 95:6", "texto": "Vinde, adoremos e prostremo-nos; ajoelhemos diante do Senhor que nos criou."},
  {"dia": 354, "ref": "Efésios 3:12", "texto": "Nele e por meio da fé nele podemos nos aproximar de Deus com liberdade e confiança."},
  {"dia": 355, "ref": "Salmos 119:68", "texto": "Tu és bom e fazes o bem; ensina-me os teus estatutos."},
  {"dia": 356, "ref": "Hebreus 12:2", "texto": "Olhemos para Jesus, o pioneiro e consumador da nossa fé."},
  {"dia": 357, "ref": "Salmos 96:11-12", "texto": "Alegrem-se os céus, exulte a terra; ressoe o mar e tudo o que nele existe. Regozijem-se os campos."},
  {"dia": 358, "ref": "1 Tessalonicenses 5:24", "texto": "Fiel é aquele que os chama, e ele o fará."},
  {"dia": 359, "ref": "Salmos 103:8", "texto": "O Senhor é compassivo e misericordioso, tardio em irar-se e transbordante de amor."},
  {"dia": 360, "ref": "Apocalipse 1:8", "texto": "Eu sou o Alfa e o Ômega, diz o Senhor Deus, aquele que é, que era e que há de vir, o Todo-Poderoso."},
  {"dia": 361, "ref": "Salmos 31:15", "texto": "Os meus dias estão nas tuas mãos; livra-me das mãos dos meus inimigos e dos que me perseguem."},
  {"dia": 362, "ref": "João 15:9", "texto": "Como o Pai me amou, também eu os amei; permaneçam no meu amor."},
  {"dia": 363, "ref": "Salmos 71:6", "texto": "Por ti fui sustentado desde o ventre materno; tu me tiraste do ventre de minha mãe. O meu louvor é sempre para ti."},
  {"dia": 364, "ref": "Isaías 40:8", "texto": "A erva se seca e a flor murcha, mas a palavra do nosso Deus permanece para sempre."},
  {"dia": 365, "ref": "Salmos 23:1-3", "texto": "O Senhor é o meu pastor; nada me faltará. Ele me faz repousar em pastos verdejantes, guia-me para junto de águas tranquilas, restaura-me o vigor."}
]

